# Copy this file to .env (git-ignored) and fill in real values.
# Nothing in this repo should ever hardcode an AWS account ID or bucket name --
# see architecture/architecture.md for why.

# --- AWS ---
AWS_REGION=us-east-2
AWS_ACCOUNT_ID=REPLACE_ME
RETAIL_ANALYTICS_BUCKET_NAME=retail-analytics-platform-REPLACE_ME

# Used by lambda/lambda_function.py
CRAWLER_NAME=retail-analytics-crawler

# Used by airflow/retail_pipeline_dag.py as a fallback if the
# "retail_analytics_bucket_name" Airflow Variable isn't set.
# (same value as RETAIL_ANALYTICS_BUCKET_NAME above)

# --- Snowflake (production dbt target) ---
SNOWFLAKE_ACCOUNT=REPLACE_ME
SNOWFLAKE_USER=REPLACE_ME
SNOWFLAKE_PASSWORD=REPLACE_ME
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_DATABASE=RETAIL_ANALYTICS
SNOWFLAKE_WAREHOUSE=TRANSFORMING
SNOWFLAKE_SCHEMA=ANALYTICS
